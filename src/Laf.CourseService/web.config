<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- Gelebilecek Max Dosya Boyutu: 500 MB (524288000 bayt) -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="524288000" />
      </requestFiltering>
    </security>

    <!-- HLS Akış MIME Türleri ve İstemci Önbelleğe Alma -->
    <staticContent>
      <remove fileExtension=".m3u8" />
      <mimeMap fileExtension=".m3u8" mimeType="application/vnd.apple.mpegurl" />
      <remove fileExtension=".ts" />
      <mimeMap fileExtension=".ts" mimeType="video/mp2t" />
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" /> <!-- cachede kalma süresi 1 gün. -->
    </staticContent>

    <!-- ASP.NET Core İşlem İçi (In-Process) Barındırma Modülü -->
    <handlers>
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>

    <aspNetCore processPath="dotnet"
                arguments=".\Laf.CourseService.dll"
                stdoutLogEnabled="false"
                stdoutLogFile=".\logs\stdout"
                hostingModel="inprocess">
      <environmentVariables>
        <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
      </environmentVariables>
    </aspNetCore>
  </system.webServer>
</configuration>